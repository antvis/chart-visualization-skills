# Three models are evaluated in parallel, each with its own base URL + key.
# Select one at runtime with `--model kimi|glm|deepseek`.
# BASE_URL is the full OpenAI-compatible base (including /v1).

# Kimi-K2.5
KIMI_BASE_URL=https://your-kimi-endpoint/v1
KIMI_API_KEY=your-kimi-key

# GLM-5.1
GLM_BASE_URL=https://your-glm-endpoint/v1
GLM_API_KEY=your-glm-key

# DeepSeek-Flash
DEEPSEEK_BASE_URL=https://your-deepseek-endpoint/v1
DEEPSEEK_API_KEY=your-deepseek-key

# Sampling temperature (optional, default 0.3)
AI_TEMPERATURE=0.3
