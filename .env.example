# AI Provider API Keys
# Uncomment and fill in the API keys for the providers you want to use

# Qwen (Alibaba Cloud DashScope)
# Get your API key from: https://dashscope.aliyun.com/
QWEN_API_KEY=your-qwen-api-key-here
# QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com
# QWEN_API_PATH=/compatible-mode/v1/chat/completions

# DeepSeek
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_API_ENDPOINT=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_API_ENDPOINT=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6-20250514

# OpenAI
# Get your API key from: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_API_ENDPOINT=https://api.openai.com

# Optional: Default AI Model
# AI_MODEL=qwen-coder-plus-latest
