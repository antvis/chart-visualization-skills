{
  "name": "chart-visualization-skills",
  "version": "1.0.0",
  "description": "Chart visualization and icon retrieval skills",
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node bin/skills-antv.js build",
    "validate": "node bin/skills-antv.js validate",
    "retrieve": "node bin/skills-antv.js retrieve",
    "web": "node web/server.js",
    "web:dev": "nodemon --watch web --watch utils --watch skills --ext js,md web/server.js",
    "eval:llm": "node eval/cli.js eval",
    "eval:llm:bm25": "node eval/cli.js eval --retrieval=bm25",
    "eval:llm:tool-call": "node eval/cli.js eval --retrieval=tool-call",
    "eval:llm:context7": "node eval/cli.js eval --retrieval=context7",
    "eval:server": "node eval/server.js",
    "eval:server:dev": "node eval/server.js --dev",
    "eval:loop": "node eval/auto-loop.js --dry-run",
    "eval:loop:bm25": "node eval/auto-loop.js --dry-run --retrieval=bm25",
    "eval:cli": "node eval/cli.js",
    "eval:compare": "node eval/cli.js compare",
    "test:antv-skills": "node test/antv-skills.test.js"
  },
  "keywords": [],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^6.33.0",
    "uuid": "^9.0.0",
    "ws": "^8.14.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "nodemon": "^3.0.0",
    "playwright": "^1.59.1",
    "vitest": "^1.2.0"
  }
}
